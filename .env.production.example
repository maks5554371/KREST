# Prod-Vorlage. Auf dem Server nach .env.production kopieren und ausfüllen.
#   cp .env.production.example .env.production
# Werte für ADMIN_PASSWORD_HASH + SESSION_SECRET erzeugen:
#   node scripts/hash-password.mjs "<sicheres-admin-passwort>"
# Achtung: keine "$" in Werten (Next expandiert "$name" als Variable).

# Absolute Pfade auf persistentem Speicher – überleben ein Redeploy.
DATABASE_PATH=/var/lib/kret/kret.db
UPLOAD_PATH=/var/lib/kret/uploads

# Aus scripts/hash-password.mjs übernehmen:
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# WICHTIG bei Betrieb über nackte IP / http (ohne HTTPS): auf false setzen,
# sonst sendet der Browser das Admin-Cookie nicht und der Login schlägt fehl.
# Auf true umstellen, sobald eine Domain mit HTTPS eingerichtet ist.
COOKIE_SECURE=false
